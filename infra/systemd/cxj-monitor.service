[Unit]
Description=Chengxinjian readiness, media jobs and backup monitoring
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/cxj/ops/staging_maintenance.py monitor
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/cxj
